# Copy to .env (or export directly) and fill in for anything beyond local dev.
# Neither variable is required for local development - both have safe
# local-only defaults (SQLite file, and a non-secret dev SECRET_KEY).

# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/trusted_data_power
# SECRET_KEY=replace-with-a-long-random-value-before-any-real-deployment
